<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      xUnit owns regression execution. Program.Main in HarnessCore.cs remains only as
      the assembly-load smoke entry point used by offline validation. Migration now
      removes test implementations from the shared Program helper namespace one area
      at a time; see tests/Sussudio.Tests/MIGRATION.md.
    -->
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="FFmpeg.AutoGen" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Sussudio.Automation.Contracts\Sussudio.Automation.Contracts.csproj" />
    <!-- Execute the complete managed controller logic with test-only UI boundaries. -->
    <Compile Include="..\..\Sussudio\Controllers\Dispatch\UiDispatchControllers.cs" Link="Production\UiDispatchControllers.cs" />
    <!-- Dependency-free production policies executed directly by their unit tests. -->
    <Compile Include="..\..\Sussudio\Models\StatusMessages.cs" Link="Production\StatusMessages.cs" />
    <Compile Include="..\..\Sussudio\Services\Preview\PreviewOutputSizePolicy.cs" Link="Production\PreviewOutputSizePolicy.cs" />
    <Compile Include="..\..\Sussudio\Services\Automation\PreviewPacingSlowStageClassifier.cs" Link="Production\PreviewPacingSlowStageClassifier.cs" />
    <Compile Include="..\..\Sussudio\Controllers\Audio\AudioControlBindingController.cs" Link="Production\AudioControlBindingController.cs" />
    <Compile Include="..\..\Sussudio\Controllers\Capture\CaptureBindingControllers.cs" Link="Production\CaptureBindingControllers.cs" />
    <Compile Include="..\..\Sussudio\ViewModels\FrameRateTimingPolicy.Match.cs" Link="Production\FrameRateTimingPolicy.Match.cs" />
    <Compile Include="..\..\Sussudio\Services\Runtime\AppProcessStartup.cs" Link="Production\AppProcessStartup.cs" />
    <Compile Include="..\..\Sussudio\Models\Recording\RecordingSettingsSelection.cs" Link="Production\RecordingSettingsSelection.cs" />
    <Compile Include="..\..\Sussudio\Controllers\ViewModel\MainViewModelRecordingSettingsController.cs" Link="Production\MainViewModelRecordingSettingsController.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pure telemetry/geometry code is tested directly without loading WinUI. -->
    <Compile Include="..\..\Sussudio\Services\Preview\PreviewFrameTimeHistory.cs" Link="Production\PreviewFrameTimeHistory.cs" />
    <Compile Include="..\..\Sussudio\Controllers\Stats\FrameTimeGraphGeometry.cs" Link="Production\FrameTimeGraphGeometry.cs" />
    <Compile Include="..\..\Sussudio\Services\Preview\PreviewInputViewCache.cs" Link="Production\PreviewInputViewCache.cs" />
    <Compile Include="..\..\Sussudio\Controllers\ViewModel\PreviewAudioTransitionControllers.cs" Link="Production\PreviewAudioTransitionControllers.cs" />
    <!-- Performance telemetry core: pure types with no WinUI, Win32 or logger dependency. -->
    <Compile Include="..\..\Sussudio\Services\Performance\PerfHistogram.cs" Link="Production\PerfHistogram.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\PerfCounter.cs" Link="Production\PerfCounter.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\PerfRegistry.cs" Link="Production\PerfRegistry.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\PerfWindowSet.cs" Link="Production\PerfWindowSet.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\PerfMetrics.cs" Link="Production\PerfMetrics.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\FrameTraceEventKind.cs" Link="Production\FrameTraceEventKind.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\FrameTraceBuffer.cs" Link="Production\FrameTraceBuffer.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\PerfMarkers.cs" Link="Production\PerfMarkers.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\FrameTraceRecorder.cs" Link="Production\FrameTraceRecorder.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\TuningKnobStore.cs" Link="Production\TuningKnobStore.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\TuningKnobCatalog.cs" Link="Production\TuningKnobCatalog.cs" />
    <Compile Include="..\..\Sussudio\Services\Performance\LogTapBuffer.cs" Link="Production\LogTapBuffer.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tool-side performance analysis (frame trace analyzer, experiment runner): pure code shared with ssctl and McpServer. -->
    <Compile Include="..\..\tools\Common\Performance\*.cs" Link="Production\ToolsPerformance\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\RecordingStructure\*.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\RecordingStructure\manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
