<Project>
  <!-- Publish and repo-local build workflow for the app project. -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <LatestBuildRoot>$(MSBuildProjectDirectory)\..\latest-build\</LatestBuildRoot>
  </PropertyGroup>

  <!-- Keep the SDK's configuration-dependent initialization body and ordering,
       but run it explicitly after normal process admission. Its module hook
       otherwise runs before Main, including in private native-probe children.
       Only an obj copy is changed; the NuGet source remains untouched. -->
  <Target Name="DeferWindowsAppRuntimeInitialization"
          AfterTargets="WindowsAppRuntimeAutoInitializer"
          Condition="'$(WindowsAppSdkAutoInitialize)' == 'true'">
    <ItemGroup>
      <_WindowsAppRuntimeInitializerSource Include="@(Compile)"
          Condition="'%(Compile.Filename)%(Compile.Extension)' == 'WindowsAppRuntimeAutoInitializer.cs'" />
    </ItemGroup>
    <Error Condition="'@(_WindowsAppRuntimeInitializerSource->Count())' != '1'"
           Text="Expected one Windows App SDK common initializer source; review deferred startup integration after the SDK change." />
    <ReadLinesFromFile File="@(_WindowsAppRuntimeInitializerSource)">
      <Output TaskParameter="Lines" ItemName="_WindowsAppRuntimeInitializerLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_WindowsAppRuntimeInitializerHook Include="@(_WindowsAppRuntimeInitializerLine)"
          Condition="'%(_WindowsAppRuntimeInitializerLine.Identity)' == '[global::System.Runtime.CompilerServices.ModuleInitializer]'" />
    </ItemGroup>
    <Error Condition="'@(_WindowsAppRuntimeInitializerHook->Count())' != '1'"
           Text="Expected one Windows App SDK module-initializer attribute; review deferred startup integration after the SDK change." />
    <ItemGroup>
      <_WindowsAppRuntimeInitializerLine Remove="@(_WindowsAppRuntimeInitializerHook)" />
    </ItemGroup>
    <PropertyGroup>
      <_DeferredWindowsAppRuntimeInitializer>$(IntermediateOutputPath)Generated Files\WindowsAppSDK\WindowsAppRuntimeStartup.g.cs</_DeferredWindowsAppRuntimeInitializer>
      <DefineConstants>$(DefineConstants);SUSSUDIO_EXPLICIT_WINDOWS_APP_RUNTIME_STARTUP</DefineConstants>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)Generated Files\WindowsAppSDK" />
    <WriteLinesToFile File="$(_DeferredWindowsAppRuntimeInitializer)"
                      Lines="@(_WindowsAppRuntimeInitializerLine)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Remove="@(_WindowsAppRuntimeInitializerSource)" />
      <Compile Include="$(_DeferredWindowsAppRuntimeInitializer)" />
      <FileWrites Include="$(_DeferredWindowsAppRuntimeInitializer)" />
    </ItemGroup>
  </Target>

  <!-- Strip WinUI satellite locale folders that SatelliteResourceLanguages doesn't cover.
       English-only: keep en-US/en-us. Remove all other ??-?? directories. -->
  <Target Name="StripUnwantedLocales"
          AfterTargets="Build;Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -Command &quot;Get-ChildItem '$(TargetDir)' -Directory | Where-Object { $_.Name -match '^[A-Za-z]{2,3}(-[A-Za-z]+)+$' -and $_.Name.ToLowerInvariant() -ne 'en-us' } | Remove-Item -Recurse -Force&quot;"
          ContinueOnError="WarnAndContinue" />
    <Exec Command="powershell -NoProfile -Command &quot;if (Test-Path '$(PublishDir)') { Get-ChildItem '$(PublishDir)' -Directory | Where-Object { $_.Name -match '^[A-Za-z]{2,3}(-[A-Za-z]+)+$' -and $_.Name.ToLowerInvariant() -ne 'en-us' } | Remove-Item -Recurse -Force }&quot;"
          Condition="'$(PublishDir)' != ''"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="StageLatestBuildToRepoRoot"
          AfterTargets="Build"
          Condition="'$(StageLatestBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Message Text="Staging latest build output to $(LatestBuildRoot)" Importance="High" />
    <RemoveDir Directories="$(LatestBuildRoot)" ContinueOnError="WarnAndContinue" />
    <MakeDir Directories="$(LatestBuildRoot)" ContinueOnError="WarnAndContinue" />
    <ItemGroup>
      <LatestBuildFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LatestBuildFiles)"
          DestinationFiles="@(LatestBuildFiles->'$(LatestBuildRoot)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
