<?xml version="1.0" encoding="utf-8"?>
<!-- Detached presentation of the same capture and preview statistics as the dock. -->
<Window
    x:Class="Sussudio.StatsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Performance">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" RequestedTheme="Dark" Padding="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="StatsLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="StatsValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="StatsSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="StatsCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel Spacing="12">
                <TextBlock Text="PERFORMANCE" Style="{StaticResource StatsSectionHeaderStyle}" />
                <TextBlock Text="Capture and preview" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SessionStateValue" Text="Idle" Style="{StaticResource StatsLabelStyle}" />
                    <ToggleSwitch x:Name="AlwaysOnTopToggle" Grid.Column="1" Header="Always on top"
                                  Toggled="AlwaysOnTopToggle_Toggled" OffContent="Off" OnContent="On" />
                </Grid>
                <Border Style="{StaticResource StatsCardStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="HEALTH" Style="{StaticResource StatsSectionHeaderStyle}" />
                        <TextBlock x:Name="DiagnosticStatusValue" Text="Unknown" Style="{StaticResource StatsValueStyle}" FontSize="16" />
                        <TextBlock x:Name="DiagnosticStageValue" Text="Waiting for samples" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="DiagnosticEvidenceValue" Text="Start preview or recording to collect live diagnostics." Style="{StaticResource StatsLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatsCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CAPTURE DELIVERY" Style="{StaticResource StatsSectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="SourceFpsValue" Text="—" Style="{StaticResource StatsValueStyle}" FontSize="26" />
                            <TextBlock Text="fps" Style="{StaticResource StatsLabelStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Target" Style="{StaticResource StatsLabelStyle}" />
                            <TextBlock x:Name="SourceExpectedFpsValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                            <TextBlock Text="fps" Style="{StaticResource StatsLabelStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="SourceAvgValue" Text="— avg" Style="{StaticResource StatsValueStyle}" />
                            <TextBlock x:Name="SourceP95Value" Text="— P95" Style="{StaticResource StatsValueStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatsCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PREVIEW PRESENTS" Style="{StaticResource StatsSectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="PreviewFpsValue" Text="—" Style="{StaticResource StatsValueStyle}" FontSize="26" />
                            <TextBlock Text="fps" Style="{StaticResource StatsLabelStyle}" />
                        </StackPanel>
                        <TextBlock Text="Present-call cadence; not a scan-out measurement" Style="{StaticResource StatsLabelStyle}" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="PreviewAvgValue" Text="— avg" Style="{StaticResource StatsValueStyle}" />
                            <TextBlock x:Name="PreviewP95Value" Text="— P95" Style="{StaticResource StatsValueStyle}" />
                        </StackPanel>
                        <TextBlock Text="Long present intervals" Style="{StaticResource StatsLabelStyle}" Margin="0,4,0,0" />
                        <TextBlock x:Name="PreviewSlowValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock Text="Estimated capture → preview latency" Style="{StaticResource StatsLabelStyle}" Margin="0,4,0,0" />
                        <TextBlock x:Name="PipelineLatencyValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="DETAILS" Style="{StaticResource StatsSectionHeaderStyle}" Margin="0,4,0,0" />
                <Expander Header="Input signal" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Resolution" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="SourceResolutionValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock Text="Frame rate" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="SourceFrameRateValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock Text="HDR and color" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="SourceHdrValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock Text="Pixel format" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="SourceFormatValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock Text="Telemetry source" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="TelemetryOriginValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                    </StackPanel>
                </Expander>
                <Expander Header="Capture gaps and jitter" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Interval jitter" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="SourceJitterValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock Text="Severe gaps" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="SourceGapsValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock Text="Estimated missing capture frames" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="SourceDropsValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                    </StackPanel>
                </Expander>
                <Expander Header="Delivery and queue counts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Capture delivery" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="SourceDeliveredValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock x:Name="SourceDroppedValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock Text="Preview queue" Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="RendererRenderedValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                        <TextBlock x:Name="RendererDroppedValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                    </StackPanel>
                </Expander>
                <Expander Header="Diagnostics and evidence" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="TelemetryDetailsContent" Spacing="6" />
                </Expander>
                <Expander Header="Legacy health score" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="A counter-based summary; use timing and warnings above to investigate hitches." Style="{StaticResource StatsLabelStyle}" />
                        <TextBlock x:Name="PerfScoreValue" Text="—" Style="{StaticResource StatsValueStyle}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
